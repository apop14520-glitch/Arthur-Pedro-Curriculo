{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "arthur-pedro-curriculo",
  "main": "./src/worker.js",
  "compatibility_date": "2026-08-18",
  "preview_urls": false,
  "keep_vars": true,
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none"
  }
}
